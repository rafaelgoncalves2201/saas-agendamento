# BANCO DE DADOS (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# APLICAÇÃO
PORT=3000
NODE_ENV="production"
APP_URL="https://seu-dominio-ou-vercel.vercel.app"
API_URL="https://seu-backend-no-render.onrender.com"

# AUTENTICAÇÃO JWT
JWT_ACCESS_SECRET="gere_um_hash_seguro_para_access_token_64chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="gere_um_hash_seguro_para_refresh_token_64chars"
JWT_REFRESH_EXPIRES_IN="7d"

# SUPER ADMIN INICIAL (Seed)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="rgcarmo545@gmail.com"
SUPER_ADMIN_PASSWORD="SuaSenhaSeguraAqui"

# GATEWAY ASAAS (Produção)
ASAAS_API_KEY="$aact_prod_..."
ASAAS_API_URL="https://api.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN="crie_um_token_seguro_de_webhook_asaas"

# WHATSAPP (Evolution API ou Z-API se for usar na nuvem)
WHATSAPP_PROVIDER="EVOLUTION"
EVOLUTION_API_URL="https://sua-evolution-api.com"
EVOLUTION_INSTANCE_NAME="saas-agendamento"
EVOLUTION_API_KEY="sua_chave_global_evolution"

